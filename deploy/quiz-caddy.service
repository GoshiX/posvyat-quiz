[Unit]
Description=HTTPS proxy for initiation quiz
Wants=network-online.target
After=network-online.target initiation-quiz.service

[Service]
Type=simple
User=quizproxy
Group=quizproxy
Environment=XDG_DATA_HOME=/var/lib/quiz-caddy
Environment=XDG_CONFIG_HOME=/var/lib/quiz-caddy/config
ExecStart=/opt/caddy/current/caddy run --config /etc/quiz-caddy/Caddyfile --adapter caddyfile
ExecReload=/opt/caddy/current/caddy reload --config /etc/quiz-caddy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/quiz-caddy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
